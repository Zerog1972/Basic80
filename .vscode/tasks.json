{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: clang.exe build active file",
			"command": "C:\\Program Files\\LLVM\\bin\\clang.exe",
			"args": [
				"-std=c89",
				"-pedantic",
				"-Wall",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}\\${fileBasenameNoExtension}.exe"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "Compile le fichier actif uniquement"
		},
		{
			"type": "shell",
			"label": "C/C++: clang.exe build all files",
			"command": "clang",
			"args": [
				"-std=c89",
				"-pedantic",
				"-Wall",
				"-g",
				"*.c",
				"-o",
				"${workspaceFolderBasename}.exe"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Compile tous les fichiers .c du projet"
		}
	]
}
