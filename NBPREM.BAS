20 PRINT "NOMBRES PREMIERS (METHODE LENTE)"
30 PRINT "2 "; : REM 2 EST LE SEUL PAIR
40 FOR N = 3 TO 1000 STEP 2 : REM ON TESTE UNIQUEMENT LES IMPAIRS
50 ESTPREMIER = 1 : REM DRAPEAU (BOOLEEN)
60 FOR D = 3 TO SQR(N) STEP 2
70 IF N / D = INT(N / D) THEN ESTPREMIER = 0 : GOTO 100
80 NEXT D
90 IF ESTPREMIER = 1 THEN PRINT STR$(N);" ";
100 NEXT N
110 PRINT : END
